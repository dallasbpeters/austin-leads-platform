{
  "extends": ["stylelint-config-standard"],
  "ignoreFiles": [
    "**/.next/**",
    "**/node_modules/**",
    "**/dist/**",
    "**/coverage/**",
    "**/playwright-report/**",
    "**/test-results/**"
  ],
  "rules": {
    "at-rule-no-unknown": [
      true,
      {
        "ignoreAtRules": [
          "tailwind",
          "apply",
          "layer",
          "config",
          "theme",
          "custom-variant",
          "view-transition",
          "keyframes"
        ]
      }
    ],
    "property-no-unknown": [
      true,
      {
        "ignoreProperties": ["view-transition-name"]
      }
    ],
    "selector-class-pattern": null,
    "import-notation": "string"
  }
}
