{
  "name": "austin-leads-platform",
  "version": "1.0.0",
  "description": "Austin Solar Pros landing page built with Next.js",
  "keywords": [],
  "license": "ISC",
  "author": "",
  "type": "module",
  "scripts": {
    "test": "NODE_ENV=test vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:playwright": "playwright test",
    "test:a11y": "playwright test",
    "dev": "node scripts/dev-all.mjs",
    "dev:next": "next dev",
    "studio:dev": "sanity dev",
    "studio:deploy": "sanity deploy",
    "dev:stop": "node scripts/stop-dev.mjs",
    "prebuild": "node scripts/sync-reel-assets.mjs",
    "build": "next build --webpack",
    "analyze": "ANALYZE=true NODE_OPTIONS=--max-old-space-size=16384 next build --webpack",
    "start": "next start",
    "seed:pages": "node --env-file=.env.local scripts/seed-public-pages.mjs",
    "seed:guides": "node --env-file=.env.local scripts/seed-guides.mjs",
    "seed:cards": "node scripts/seed-cards.mjs",
    "sync:homepage": "node --env-file=.env.local scripts/sync-homepage-page.mjs",
    "db:setup": "node --env-file=.env.development.local scripts/setup-db.mjs",
    "db:pull": "node --env-file=.env.local node_modules/drizzle-kit/bin.cjs pull --config=drizzle.config.ts",
    "db:generate": "node --env-file=.env.local node_modules/drizzle-kit/bin.cjs generate --config=drizzle.config.ts",
    "db:migrate": "node --env-file=.env.local node_modules/drizzle-kit/bin.cjs migrate --config=drizzle.config.ts",
    "db:studio": "node --env-file=.env.local node_modules/drizzle-kit/bin.cjs studio --config=drizzle.config.ts",
    "zoho:exchange": "node --env-file=.env.development.local scripts/zoho-exchange-code.mjs",
    "sanity:repair-sections": "node --env-file=.env.local scripts/repair-section-types.mjs",
    "sanity:migrate-gallery-projects": "node --env-file=.env.local scripts/migrate-gallery-projects.mjs",
    "vercel:env:push": "node --env-file=.env.local scripts/push-env-to-vercel.mjs .env.local",
    "vercel:env:push:dry": "node --env-file=.env.local scripts/push-env-to-vercel.mjs .env.local --dry-run",
    "generate:favicons": "node scripts/generate-favicons.mjs",
    "generate:service-images": "node scripts/generate-service-images.mjs",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "lint": "oxlint",
    "audit:css-classes": "node scripts/css-class-usage-audit.mjs",
    "audit:schema": "node --env-file=.env --env-file-if-exists=.env.local scripts/schema-usage-dump.mjs > .schema-usage.json && node scripts/audit-schema-fields.mjs .schema-usage.json > docs/schema-field-audit.md",
    "check": "ultracite check",
    "fix": "ultracite fix",
    "prepare": "husky",
    "video:sync": "node --env-file=.env.local scripts/sync-video-project.mjs",
    "video:yt:auth": "node --env-file=.env.local scripts/youtube-auth.mjs",
    "video:yt:push": "node --env-file=.env.local scripts/youtube-upload.mjs",
    "video:seed": "node --env-file=.env.local scripts/seed-video-project.mjs",
    "reels:assets": "node scripts/sync-reel-assets.mjs",
    "reels:assets:brand": "node scripts/sync-reel-assets.mjs brand",
    "reels:assets:christmas": "node scripts/sync-reel-assets.mjs christmas",
    "reels:watch": "node scripts/watch-reel-assets.mjs",
    "reels:watch:brand": "node scripts/watch-reel-assets.mjs brand",
    "reels:watch:christmas": "node scripts/watch-reel-assets.mjs christmas",
    "reels:check": "pnpm reels:check:brand && pnpm reels:check:christmas",
    "reels:check:brand": "npx --yes hyperframes@0.8.46 check videos/brand-reels",
    "reels:check:christmas": "npx --yes hyperframes@0.8.46 check videos/christmas-reels",
    "reels:frames:brand": "npx --yes hyperframes@0.8.46 snapshot videos/brand-reels --frames 5",
    "reels:frames:christmas": "npx --yes hyperframes@0.8.46 snapshot videos/christmas-reels --frames 5",
    "video:render:push": "node --env-file=.env.local scripts/push-render.mjs"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.97",
