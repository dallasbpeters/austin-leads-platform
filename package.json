{
  "name": "austin-leads-platform",
  "version": "1.0.0",
  "description": "Austin Solar Pros landing page built with Next.js",
  "scripts": {
    "dev": "node scripts/dev-all.mjs",
    "dev:next": "NEXT_PUBLIC_LOCAL_SANITY_STUDIO_URL=http://localhost:3334 SANITY_STUDIO_PREVIEW_ORIGIN=http://localhost:3000 next dev",
    "studio:dev": "NEXT_PUBLIC_LOCAL_SANITY_STUDIO_URL=http://localhost:3334 SANITY_STUDIO_PREVIEW_ORIGIN=http://localhost:3000 sanity dev --port 3334",
    "studio:deploy": "sanity deploy",
    "dev:stop": "node scripts/stop-dev.mjs",
    "build": "next build --webpack",
    "start": "next start",
    "seed:pages": "node --env-file=.env.local scripts/seed-public-pages.mjs",
    "seed:guides": "node --env-file=.env.local scripts/seed-guides.mjs",
    "sync:homepage": "node --env-file=.env.local scripts/sync-homepage-page.mjs",
    "db:setup": "node --env-file=.env.local scripts/setup-neon.mjs",
    "sanity:repair-sections": "node --env-file=.env.local scripts/repair-section-types.mjs",
    "generate:favicons": "node scripts/generate-favicons.mjs",
    "generate:service-images": "node scripts/generate-service-images.mjs",
    "format": "prettier . --write",
    "format:check": "prettier . --check"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.32.1",
  "dependencies": {
    "@emotion/styled": "^11.14.1",
    "@google-analytics/data": "^5.2.1",
    "@neondatabase/serverless": "^1.0.2",
    "@next/third-parties": "16.1.6",
    "@sanity/color-input": "^6.0.4",
    "@sentry/react": "^10.43.0",
    "@types/react": "^19.2.14",
    "@vercel/analytics": "^1.6.1",
    "@vercel/og": "^0.11.1",
    "@vercel/speed-insights": "^1.3.1",
    "@vercel/toolbar": "^0.2.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.35.2",
    "groq": "^5.13.0",
    "iconoir-react": "^7.11.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.577.0",
    "next": "^16.1.6",
    "next-auth": "5.0.0-beta.30",
    "next-sanity": "^12.1.1",
    "radix-ui": "^1.4.3",
    "react": "^19.2.4",
    "react-best-gradient-color-picker": "^3.0.14",
    "react-dom": "^19.2.4",
    "react-leaflet": "^5.0.0",
    "resend": "^6.9.3",
    "sanity": "^5.13.0",
    "sanity-plugin-gemini-ai-images": "^1.3.0",
    "sanity-plugin-gemini-ai-images-nextjs": "^1.1.0",
    "styled-components": "^6.1.15",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "unicornstudio-react": "^2.1.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.1",
    "png-to-ico": "^3.0.1",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.2.1"
  }
}
