    "clsx": "^2.1.1",
    "d3": "^7.9.2",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.4",
    "framer-motion": "^14.10.1",
    "groq": "^6.22.0",
    "iconoir-react": "^7.12.2",
    "leaflet": "^1.9.4",
    "lottie-react": "^2.4.2",
    "lucide-react": "^1.70.0",
    "mapbox-gl": "^3.34.2",
    "next": "16.4.5",
    "next-auth": "5.0.0-beta.30",
    "next-sanity": "^13.4.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.5.438",
    "pg": "^8.23.1",
    "pixelarticons": "^2.4.2",
    "playwright": "^1.65.0",
    "posthog-js": "^1.447.3",
