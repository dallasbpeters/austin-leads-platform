{
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    },
    "types": []
  },
  "typeAcquisition": {
    "enable": false
  },
  "include": [
    "src/**/*.js",
    "src/**/*.jsx",
    "sanity.config.js",
    "sanity.cli.js",
    "next.config.mjs",
    "proxy.js"
  ],
  "exclude": ["node_modules", ".next", ".vercel", "dist", ".pnpm-store"]
}
