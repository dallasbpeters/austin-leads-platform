NEXT_PUBLIC_SANITY_PROJECT_ID=xuhfhjna
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-10-21
NEXT_PUBLIC_SITE_URL=https://texassolarandroofingpros.com
NEXT_PUBLIC_LOCAL_SITE_URL=http://localhost:3000
# Production/staging Next origin for Presentation + Studio tools (/api/gemini, PageSpeed). Local `sanity dev` defaults to http://localhost:3000 when unset (see src/sanity/env.js).
SANITY_STUDIO_PREVIEW_ORIGIN=https://texassolarandroofingpros.com
SANITY_AGENT_SCHEMA_ID=
SANITY_STUDIO_AGENT_SCHEMA_ID=
GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Per-site GA measurement IDs — JSON object keyed by site slug.
# Overrides NEXT_PUBLIC_GA_MEASUREMENT_ID for matching sites.
# Example: {"txchristmaslights":"G-TJB8JYY5EP","texas-solar-and-roofing-pros":"G-2D5H4B969C"}
NEXT_PUBLIC_GA_MEASUREMENT_IDS=
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_POSTHOG_KEY=
# Browser PostHog traffic should stay on the local `/ingest` proxy so
# next.config.mjs can rewrite requests to PostHog upstream.
# Do not point this at the public tenant domain.
NEXT_PUBLIC_POSTHOG_HOST=/ingest
# Per-site PostHog project keys — JSON object keyed by site slug.
# Overrides NEXT_PUBLIC_POSTHOG_KEY for matching sites.
# Example: {"txchristmaslights":"phc_xxx","texas-solar-and-roofing-pros":"phc_yyy"}
NEXT_PUBLIC_POSTHOG_KEYS=
NEXT_PUBLIC_FACEBOOK_APP_ID=
GOOGLE_ANALYTICS_PROPERTY_ID=
GOOGLE_ANALYTICS_SERVICE_ACCOUNT_JSON=
GOOGLE_ANALYTICS_CLIENT_EMAIL=
GOOGLE_ANALYTICS_PRIVATE_KEY=
NEXT_PUBLIC_SANITY_STUDIO_URL=https://austin-leads-platform.sanity.studio

# Optional override for Studio `appId` (defaults in src/sanity/env.js from this repo’s hosted Studio deployment).
# If Assist still shows “not enabled”: confirm Growth+ plan, then in Studio open a document → ✨ → Manage instructions → Enable AI assistance (creates “Sanity AI” token in Manage).
SANITY_STUDIO_APP_ID=
DATABASE_URL=
NEON_DATABASE_URL=
AUTH_SECRET=
AUTH_ADMIN_NAME=Platform Admin
AUTH_ADMIN_EMAIL=admin@austinleadsplatform.local
AUTH_ADMIN_PASSWORD=

# Google OAuth — dashboard sign-in via NextAuth (`/api/auth/callback/google`).
# Only Google accounts whose email matches an active `platform_users` row (or AUTH_ADMIN_EMAIL) can access the admin.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Optional aliases (same values as in Google Cloud Console):
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Optional for live publish actions from the admin UI.
SANITY_API_WRITE_TOKEN=
SANITY_API_READ_TOKEN=
SANITY_VIEWER_TOKEN=

# Agent Context MCP + LLM — POST /api/chat (authenticated; Sanity document assistant, not public site chat)
# Base URL (no slug) works without an Agent Context document in Studio:
#   https://api.sanity.io/v2026-03-03/agent-context/<projectId>/<dataset>
# With a published Agent Context doc slug "site-assistant":
#   https://api.sanity.io/v2026-03-03/agent-context/<projectId>/<dataset>/site-assistant
SANITY_CONTEXT_MCP_URL=
# At least one LLM key. If both are set, Groq is used unless CHAT_LLM_PROVIDER=anthropic
GROQ_API_KEY=
GROQ_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
# Optional: groq | anthropic
CHAT_LLM_PROVIDER=
# Optional: appended to the server system prompt (single block; keep short)
AGENT_SYSTEM_PROMPT_EXTRA=
# Server-side Google key for /api/gemini/generate-image (AI Drafting tool). Alias: GOOGLE_GENERATIVE_AI_API_KEY.
GEMINI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
# Optional: if set, requests must send matching X-API-Key. Studio must use the same value:
#   SANITY_STUDIO_GEMINI_PLUGIN_API_KEY (sanity deploy / SANITY_STUDIO_* build env) or NEXT_PUBLIC_GEMINI_PLUGIN_API_KEY.
GEMINI_PLUGIN_API_KEY=
SANITY_STUDIO_GEMINI_PLUGIN_API_KEY=
NEXT_PUBLIC_GEMINI_PLUGIN_API_KEY=
# Optional for custom PageSpeed tool. Supports GOOGLE_PAGESPEED_API_KEY as alias.
PAGESPEED_API_KEY=

# Optional for live Unsplash search in the hero pages admin.
UNSPLASH_ACCESS_KEY=
UNSPLASH_REFERRAL_SOURCE=austin-leads-platform

# Optional for live Vercel domain management.
VERCEL_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=
VERCEL_TEAM_SLUG=

# Optional for lead notification emails.
RESEND_API_KEY=
RESEND_FROM_NAME=Texas Solar and Roofing Pros
RESEND_FROM_EMAIL=
RESEND_LEAD_TO_EMAIL=
RESEND_SUBJECT_PREFIX=New lead
RESEND_TEMPLATE_ID=

# Mapbox GL — public token for the service area map (client-side).
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=

# Stripe — Christmas Lights booking
# Use test price IDs locally, live price IDs in production (Vercel env vars).
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_DEPOSIT=
STRIPE_PRICE_XMAS_ROOFLINE=
STRIPE_PRICE_XMAS_FULL_FRONT=
STRIPE_PRICE_XMAS_FULL_PROPERTY=
